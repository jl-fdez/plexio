# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN - PLEXIO
# ==========================================

# Tu dominio o subdominio apuntando a la IP del VPS (ej: plexio.tudominio.com o tu IP si no tienes dominio)
DOMAIN=plexio.tudominio.com

# Puertos expuestos en el VPS (80 y 443 para HTTPS automático con Let's Encrypt)
HTTP_PORT=80
HTTPS_PORT=443

# Puerto directo si no usas Caddy o si usas otro proxy inverso ya instalado (ej: Nginx Proxy Manager / Traefik)
PORT=7777

# Clave secreta para tokens JWT del panel admin (Genera una con: openssl rand -hex 32)
JWT_SECRET_KEY=cambia_esta_clave_por_una_super_secreta_y_aleatoria_123456

# Algoritmo y expiración de JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Ruta de persistencia para la base de datos SQLite en el volumen montado (/app/data)
DATABASE_URL=sqlite+aiosqlite:////app/data/plexio.db

# Configuración de Caché (Usa redis para producción)
CACHE_TYPE=redis
REDIS_URL=redis://redis:6379/0

# Expresión regular para orígenes permitidos en CORS
CORS_ORIGIN_REGEX=https?:\/\/localhost:\d+|.*plexio.stream|.*strem.io|.*stremio.com|https?:\/\/.*

# Timeout para peticiones a los servidores Plex (en segundos)
PLEX_REQUESTS_TIMEOUT=20

# Token de autenticación de Plex (Opcional - Requerido solo si usas servidores Plex compartidos que no son tuyos)
# PLEX_MATCHING_TOKEN=tu_plex_token_aqui

# Sentry DSN para monitoreo de errores (Opcional)
# SENTRY_DSN=https://...
