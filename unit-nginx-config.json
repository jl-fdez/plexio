{
  "access_log": "/dev/stdout",
  "listeners": {
    "*:80": {
      "pass": "routes"
    }
  },
  "routes": [
    {
      "match": {
        "uri": "/api/*"
      },
      "action": {
        "pass": "applications/backend"
      }
    },
    {
      "match": {
        "uri": "*json"
      },
      "action": {
        "pass": "applications/backend"
      }
    },
    {
      "action": {
        "share": "/app/frontend$uri",
        "types": {
          "text/html": ["html", "htm"],
          "text/css": "css",
          "application/javascript": "js",
          "image/svg+xml": "svg",
          "image/png": "png",
          "image/jpeg": ["jpg", "jpeg"],
          "image/x-icon": "ico",
          "application/json": "json",
          "font/woff2": "woff2",
          "font/woff": "woff"
        },
        "fallback": {
          "share": "/app/frontend/index.html",
          "types": {
            "text/html": ["html", "htm"]
          }
        }
      }
    }
  ],
  "applications": {
    "backend": {
      "type": "python3",
      "path": "/app/plexio",
      "module": "main",
      "callable": "app",
      "protocol": "asgi"
    }
  }
}