{
  "access_log": "/dev/stdout",
  "listeners": {
    "*:80": {
      "pass": "routes"
    }
  },
  "routes": [
    {
      "match": {
        "uri": [
          "/api/*",
          "/u/*",
          "*json",
          "/logo.png",
          "/logo.svg",
          "/static/*"
        ]
      },
      "action": {
        "pass": "applications/backend"
      }
    },
    {
      "action": {
        "share": "/app/frontend$uri",
        "fallback": {
          "share": "/app/frontend/index.html"
        }
      }
    }
  ],
  "applications": {
    "backend": {
      "type": "python3",
      "path": "/app/plexio",
      "module": "main",
      "callable": "app",
      "protocol": "asgi"
    }
  }
}